FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
WORKDIR /app
COPY --chown=node:node mcp-server/package.json mcp-server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --chown=node:node mcp-server/src ./src
ENV NODE_ENV=production PORT=8718 HOST_ROOT=/host AUDIT_PATH=/data/audit.jsonl
USER node
EXPOSE 8718
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8718/health >/dev/null || exit 1
CMD ["node", "src/server.js"]
