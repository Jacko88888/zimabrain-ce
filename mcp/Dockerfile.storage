FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
RUN apk add --no-cache smartmontools nvme-cli btrfs-progs util-linux
WORKDIR /app
COPY storage-collector/package.json ./package.json
COPY storage-collector/src ./src
ENV NODE_ENV=production PORT=8720
USER root
EXPOSE 8720
HEALTHCHECK --interval=30s --timeout=8s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8720/health >/dev/null || exit 1
CMD ["node", "src/server.js"]
